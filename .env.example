# --- OnStar account ---
# Any random v4 UUID, generate once and keep it stable: https://www.uuidgenerator.net/version4
ONSTAR_DEVICE_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# Your vehicle's 17-character VIN
ONSTAR_VIN=XXXXXXXXXXXXXXXXX
ONSTAR_USERNAME=you@example.com
ONSTAR_PASSWORD=your-password
# 4-digit OnStar PIN
ONSTAR_PIN=1234
# TOTP secret key from setting your GM account MFA to "Third-Party Authenticator App"
ONSTAR_TOTP_KEY=XXXXXXXXXXXXXXXX
# Where OnStarJS caches auth tokens (microsoft_tokens.json / gm_tokens.json)
ONSTAR_TOKEN_LOCATION=./tokens/
# Let the bridge log in to GM by itself with a scripted browser (true/false).
# Off by default: GM's bot detection blocks these logins and each failed try
# makes the block last longer. Leave off and supply microsoft_tokens.json
# from the Firefox extension instead (see README).
ONSTAR_BROWSER_LOGIN=false

# --- Polling ---
# How often to poll diagnostics/EV metrics/location, in minutes (don't go too low; GM rate-limits)
POLL_INTERVAL_MINUTES=30
# Also poll vehicle location each cycle (true/false)
POLL_LOCATION=true

# --- MQTT (point at your Home Assistant broker, e.g. the Mosquitto add-on) ---
MQTT_URL=mqtt://homeassistant.local:1883
MQTT_USERNAME=mqttuser
MQTT_PASSWORD=mqttpass
# Base topic for state/command topics
MQTT_TOPIC_PREFIX=onstar2ha
# Home Assistant discovery prefix (leave as-is unless you changed it in HA)
HA_DISCOVERY_PREFIX=homeassistant

# --- Device naming in Home Assistant ---
VEHICLE_NAME=Blazer EV

# Log level: debug | info | warn | error
LOG_LEVEL=info
