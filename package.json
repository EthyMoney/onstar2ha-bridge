{
  "name": "onstarjs-2-ha-blazer",
  "version": "1.1.0",
  "description": "Bridge between a GM/Chevy EV (Blazer EV) and Home Assistant via OnStarJS and MQTT discovery",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/patch-onstarjs.mjs",
    "start": "node src/index.js",
    "vehicles": "node src/tools/list-vehicles.js",
    "docker:build": "node scripts/docker.mjs build",
    "docker:push": "node scripts/docker.mjs push",
    "docker:deploy": "node scripts/docker.mjs deploy"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "mqtt": "^5.16.1",
    "onstarjs2": "2.16.7"
  },
  "license": "MIT",
  "allowScripts": {
    "onstarjs2@2.16.7": true,
    "sleep@6.1.0": true
  }
}
